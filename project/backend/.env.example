# Local practice. Keep the server bound to 127.0.0.1.
TSUKIMI_ENV=development
TSUKIMI_MAIL_MODE=file

# Deployment: set TSUKIMI_ENV=production, TSUKIMI_MAIL_MODE=ses and fill these values.
# TSUKIMI_COOKIE_SECURE=1
# TSUKIMI_ALLOWED_ORIGINS=https://your-domain.example
# TSUKIMI_SES_REGION=ap-hongkong
# TSUKIMI_MAIL_FROM=Tsukimi <noreply@mail.your-domain.example>
# TSUKIMI_SES_TEMPLATE_REGISTER=
# TSUKIMI_SES_TEMPLATE_RESET=
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
